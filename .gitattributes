# Normalise text to LF in the repository
* text=auto eol=lf

# translation data is UTF-8 JSON lines; some lines carry the game's raw
# control bytes (0x07 column codes), which must not trigger binary detection
*.jsonl text eol=lf diff
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.CFG   text eol=lf

# PowerShell and DOSBox configs are read by Windows tools
*.ps1   text eol=crlf
*.conf  text eol=crlf

*.png binary
*.jpg binary
